# Verzeichnislisting deaktivieren (verhindert Auflistung von data/, vendor/ etc.)
Options -Indexes

# v2.9.22: DirectoryIndex explizit setzen (verhindert 403 beim Aufruf von "/")
DirectoryIndex index.html index.php

# Sicherheits-Header für alle Antworten (mod_headers)
<IfModule mod_headers.c>
    # PHP-Version nicht preisgeben
    Header unset X-Powered-By
    Header always unset X-Powered-By
    # Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # MIME-Sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Referrer
    Header always set Referrer-Policy "same-origin"
    # Cross-Domain-Policies (Flash/Silverlight, weitgehend obsolet aber harmlos)
    Header always set X-Permitted-Cross-Domain-Policies "none"
    # Kamera, Mikrofon etc. nicht erlauben
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Content Security Policy
    # 'unsafe-inline' + 'unsafe-eval' nötig da das Frontend Vanilla-JS mit inline-Scripts nutzt.
    # frame-ancestors 'self' verhindert Einbetten in fremde Seiten (ergänzt X-Frame-Options).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; frame-ancestors 'self';"
</IfModule>

# Zugriff auf sensible Dateien blockieren (Apache 2.4)
<FilesMatch "\.(sqlite|db|log|json|lock|phar|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# PHP-Dateien die nicht direkt aufrufbar sein sollen
<FilesMatch "^(cron_|migrate|whatsapp_).*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
