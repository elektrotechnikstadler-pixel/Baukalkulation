{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/frontend/**/*",
    "modules/*/frontend/**/*",
    "env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "deploy"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@core/*":    ["src/frontend/core/*"],
      "@modules/*": ["src/frontend/modules/*"]
    },
    /* TypeScript-Compiler-Optionen */
    "target":           "ES2020",
    "module":           "ESNext",
    "moduleResolution": "Bundler",
    "lib":              ["ES2020", "DOM", "DOM.Iterable"],
    "strict":           true,
    "noUnusedLocals":   false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck":     true,
    "noEmit":           true,
    /* Erlaubt bestehende JS-Dateien (src/frontend/core/*.js) ohne TS-Fehler */
    "allowJs":          true,
    "checkJs":          false
  }
}
