# ============================================================
# Baukalkulation – Umgebungsvariablen
# ============================================================
# Diese Datei nach ".env" kopieren und anpassen, dann:
#   docker compose up -d --build
#
# Nach Änderungen hier: IMMER mit --build neu starten,
# damit Build-Flags (ENABLE_OCR) greifen.
# ============================================================

# ─── Ports ─────────────────────────────────────────────────
APP_PORT=8081
WA_PORT=3002

# ─── Eindeutige Namen je Instanz (bei mehreren Stacks auf einem Host) ───
# Diese Werte MUESSEN pro Instanz auf demselben Host eindeutig sein, sonst
# kommt es zu Konflikten ("container name already in use") oder ein Autoheal
# startet die App der anderen Instanz neu.
#   Instanz 1:  COMPOSE_PROJECT_NAME=erp1  APP_NAME=erp1-app
#               AUTOHEAL_NAME=erp1-autoheal  AUTOHEAL_LABEL=autoheal_erp1  APP_PORT=8081
#   Instanz 2:  COMPOSE_PROJECT_NAME=erp2  APP_NAME=erp2-app
#               AUTOHEAL_NAME=erp2-autoheal  AUTOHEAL_LABEL=autoheal_erp2  APP_PORT=8082
#   (UPDATER_NAME je Instanz analog, z.B. erp1-updater / erp2-updater)
COMPOSE_PROJECT_NAME=baukalkulation-es
APP_NAME=baukalkulation-es-app
AUTOHEAL_NAME=baukalkulation-es-autoheal
AUTOHEAL_LABEL=autoheal
UPDATER_NAME=baukalkulation-es-updater

# ─── Zeitzone ──────────────────────────────────────────────
# Gültige Werte: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Berlin

# ─── Build-Flag: OCR (Tesseract + poppler) ─────────────────
# true  → Dokumentenerkennung nach Inhalt (scan, Fotos, PDFs)
#         Kosten: ~+200 MB Image, ~+200 MB RAM bei Parse, hohe CPU-Last
# false → nur Dateiname-basierte Erkennung
#         Empfehlung für NAS mit < 4 GB RAM
ENABLE_OCR=true

# ─── Laufzeit-Flag: WhatsApp-Bridge ────────────────────────
# Der Container startet nur mit:  docker compose --profile whatsapp up -d
# Diese Variable steuert zusätzlich das Frontend-Gating (Button ausblenden).
ENABLE_WHATSAPP=false

# WhatsApp-API-Token (wenn WhatsApp-Bridge genutzt wird)
WA_API_TOKEN=change-me

# ─── Support-Konto "Systemadmin" ──────────────────────────
# Startpasswort je Installation (min. 12 Zeichen). Leer lassen = zufällig erzeugt,
# nachzulesen per:  docker exec <APP_NAME> cat /var/www/html/data/systemadmin-passwort.txt
# Zurücksetzen:     docker exec -it <APP_NAME> php bin/console user:reset-password Systemadmin
BK_SYSTEMADMIN_PASSWORD=

# ─── Update aus dem Repository ─────────────────────────
# GitHub-Repository owner/name in Kleinbuchstaben (auch GHCR-Image-Name); leer = aus.
BK_UPDATE_REPO=
# Absoluter Pfad dieses Projektordners (Updater braucht denselben Pfad wie der Host).
# install.sh/install.ps1 setzen ihn automatisch.
BK_COMPOSE_DIR=
# Image-Tag = Version; wird vom Updater gepflegt. Leer = "local" (lokaler Build).
APP_IMAGE_TAG=
# Image-Variante: leer = mit OCR, -noocr = ohne OCR (muss zu ENABLE_OCR passen).
APP_IMAGE_VARIANT=

# ─── Optional: PostgreSQL (nur mit docker-compose.postgres.yml) ───
# Passwort NICHT hier, sondern in secrets/db_password.txt (siehe docs/installation.md).
# BK_DB_NAME=baukalkulation
# BK_DB_USER=baukalkulation
# PG_DATA_DIR=./pgdata
# PG_BACKUP_DIR=./data/pg-backups
# Bei mehreren Instanzen auf einem Host eindeutig setzen:
# PG_CONTAINER_NAME=baukalkulation-es-db
# PG_BACKUP_CONTAINER_NAME=baukalkulation-es-db-backup