{
    "name": "baukalkulation/api",
    "description": "Baukalkulation REST-API – SQLite Backend mit ZUGFeRD E-Rechnung",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "horstoeko/zugferd": "^1.0",
        "dompdf/dompdf": "^3.0",
        "smalot/pdfparser": "^2.0",
        "phpmailer/phpmailer": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
