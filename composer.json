{
    "name": "baukalkulation/api",
    "description": "Baukalkulation REST-API – SQLite Backend mit ZUGFeRD E-Rechnung",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "horstoeko/zugferd": "^1.0",
        "dompdf/dompdf": "^3.0",
        "smalot/pdfparser": "^2.0",
        "phpmailer/phpmailer": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:api": "phpunit --testsuite api"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
