{
    "name": "baukalkulation-es",
    "version": "3.0.4",
    "private": true,
    "description": "Baukalkulation ES – Frontend Build System (Vite)",
    "scripts": {
        "dev":     "vite",
        "build":   "vite build",
        "preview": "vite preview",
